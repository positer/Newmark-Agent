<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Selected by Android before Activity/Compose creation. The night
         qualifier therefore prevents a light launch-window flash. -->
    <style name="Theme.Newmark.Starting" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/newmark_launch_background</item>
        <item name="android:colorBackground">@color/newmark_launch_background</item>
        <item name="android:navigationBarColor">@color/newmark_launch_background</item>
        <item name="android:statusBarColor">@color/newmark_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
